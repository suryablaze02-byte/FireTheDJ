<?xml version="1.0" encoding="utf-8"?>
<!-- The GitHub build: casting to a Chromecast and updating itself from GitHub releases. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Casting to a Chromecast: capturing FireTheDJ's own audio to stream it to the TV. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- In-app updates: installing a newer FireTheDJ downloaded from its GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Streams the mix to a Chromecast while casting. -->
        <service
            android:name=".cast.CastStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- The package installer's answer about an in-app update. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.autodj.cast.CastOptionsProvider" />
    </application>
</manifest>
